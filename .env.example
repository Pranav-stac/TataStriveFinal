# Copy this file to ".env" in the project root (or edit .env directly).
# The build script bundles .env if present; otherwise it bundles this file.

# Groq — API key for VLM metadata (classroom name, date/time from CCTV frames)
# Create a key here: https://console.groq.com/keys
GROQ_API_KEY=

# Optional — GitHub repo for silent auto-updates (owner/repo). Uncomment if needed.
# TATASTRIVE_GITHUB_REPO=Pranav-stac/TataStriveFinal
