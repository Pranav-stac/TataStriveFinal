/* TataStrive Analytics - Light Theme Stylesheet */

/* ==================== Global ==================== */
QMainWindow {
    background-color: #f5f5f5;
}

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #333333;
}

/* ==================== Tab Widget ==================== */
QTabWidget::pane {
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #e8e8e8;
    border: 1px solid #d0d0d0;
    border-bottom: none;
    padding: 10px 24px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #f0f0f0;
}

/* ==================== Buttons ==================== */
QPushButton {
    background-color: #e0e0e0;
    color: #333333;
    border: 1px solid #c0c0c0;
    padding: 8px 16px;
    border-radius: 4px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #d0d0d0;
    border-color: #b0b0b0;
}

QPushButton:pressed {
    background-color: #c0c0c0;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #a0a0a0;
    border-color: #d0d0d0;
}

QPushButton#primaryButton {
    background-color: #0078d4;
    color: white;
    border: none;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #106ebe;
}

QPushButton#primaryButton:pressed {
    background-color: #005a9e;
}

QPushButton#primaryButton:disabled {
    background-color: #99c9ed;
}

QPushButton#dangerButton {
    background-color: #d32f2f;
    color: white;
    border: none;
}

QPushButton#dangerButton:hover {
    background-color: #b71c1c;
}

QPushButton#dangerButton:pressed {
    background-color: #8b0000;
}

QPushButton#dangerButton:disabled {
    background-color: #ef9a9a;
}

QPushButton#browseButton {
    min-width: 90px;
    padding: 6px 12px;
}

QPushButton#clearLogButton {
    min-width: 50px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ==================== Input Fields ==================== */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 8px 12px;
    selection-background-color: #0078d4;
}

QLineEdit:focus {
    border-color: #0078d4;
}

QLineEdit:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
}

QLineEdit[readOnly="true"] {
    background-color: #f8f8f8;
}

/* ==================== Spin Boxes ==================== */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 100px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0078d4;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #e8e8e8;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #d0d0d0;
}

/* ==================== Group Boxes ==================== */
QGroupBox {
    font-weight: 600;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #ffffff;
    color: #333333;
}

/* ==================== Frames ==================== */
QFrame#filePicker, QFrame#folderPicker {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
}

QFrame#progressPanel {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
}

QFrame#videoPreview {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
}

QFrame#summaryFrame {
    background-color: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 8px;
}

QFrame#summaryCard {
    background-color: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 4px;
}

/* ==================== Labels ==================== */
QLabel {
    color: #333333;
}

QLabel#filePickerLabel, QLabel#folderPickerLabel {
    font-weight: 600;
    color: #555555;
}

QLabel#progressLabel, QLabel#logLabel, QLabel#videoPreviewLabel {
    font-weight: 600;
    color: #333333;
}

QLabel#statusLabel {
    color: #666666;
    font-size: 12px;
}

QLabel#cardTitle {
    color: #888888;
    font-size: 11px;
    font-weight: normal;
}

QLabel#cardValue {
    color: #333333;
    font-size: 16px;
    font-weight: 600;
}

/* ==================== Progress Bar ==================== */
QProgressBar {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #f0f0f0;
    text-align: center;
    height: 24px;
}

QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 3px;
}

/* ==================== Text Edit (Log) ==================== */
QTextEdit#logTextArea {
    background-color: #fafafa;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 8px;
}

/* ==================== Tables ==================== */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    gridline-color: #e8e8e8;
}

QTableWidget::item {
    padding: 6px 8px;
}

QTableWidget::item:selected {
    background-color: #cce4f7;
    color: #333333;
}

QTableWidget::item:alternate {
    background-color: #fafafa;
}

QHeaderView::section {
    background-color: #f0f0f0;
    border: none;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    padding: 8px;
    font-weight: 600;
}

/* ==================== Tree Widget ==================== */
QTreeWidget {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
}

QTreeWidget::item {
    padding: 4px;
}

QTreeWidget::item:selected {
    background-color: #cce4f7;
    color: #333333;
}

QTreeWidget::item:alternate {
    background-color: #fafafa;
}

/* ==================== Radio Buttons ==================== */
QRadioButton {
    spacing: 8px;
    padding: 4px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #888888;
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    border: 2px solid #0078d4;
    border-radius: 9px;
    background-color: #0078d4;
}

/* ==================== Check Boxes ==================== */
QCheckBox {
    spacing: 8px;
    padding: 4px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #888888;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    border-color: #0078d4;
    background-color: #0078d4;
}

/* ==================== Date Edit ==================== */
QDateEdit {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 120px;
}

QDateEdit:focus {
    border-color: #0078d4;
}

QDateEdit::drop-down {
    border: none;
    width: 24px;
}

/* ==================== Splitter ==================== */
QSplitter::handle {
    background-color: #e0e0e0;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

/* ==================== Menu Bar ==================== */
QMenuBar {
    background-color: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
    padding: 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e0e0e0;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #e8e8e8;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

/* ==================== Status Bar ==================== */
QStatusBar {
    background-color: #f0f0f0;
    border-top: 1px solid #d0d0d0;
    padding: 4px;
}

/* ==================== Scroll Bars ==================== */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ==================== Tool Tips ==================== */
QToolTip {
    background-color: #333333;
    color: #ffffff;
    border: none;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 12px;
}

/* ==================== Dialog ==================== */
QDialog {
    background-color: #f5f5f5;
}

QDialogButtonBox {
    button-layout: 3;
}
